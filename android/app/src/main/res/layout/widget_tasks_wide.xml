<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/tasks_widget_root" android:padding="12dp" android:background="@drawable/widget_tasks_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:layout_weight="1">
        <LinearLayout android:layout_width="112dp" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="14dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/tasks_widget_logo" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/omnesis_logo" android:tint="@color/tasks_widget_accent" android:padding="0dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/tasks_widget_accent" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_brand" android:text="OMNESIS" android:letterSpacing="0.16" android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="21sp" android:textColor="@color/tasks_widget_ink" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:id="@+id/tasks_widget_title" android:text="Today" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/tasks_widget_count_block" android:gravity="center_vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-light" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_count" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:text=" to do" android:letterSpacing="0.0" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:layout_marginTop="1dp">
                <TextView android:layout_width="0dp" android:layout_height="24dp" android:textSize="10sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_day" android:text="Day" android:layout_weight="1" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="24dp" android:textSize="10sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_week" android:text="Week" android:layout_weight="1" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="24dp" android:textSize="10sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_month" android:text="Month" android:layout_weight="1" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:importantForAccessibility="no" android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_marginEnd="10dp" android:background="@color/tasks_widget_divider" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:id="@+id/tasks_widget_rows" android:layout_weight="1" android:layout_marginTop="1dp" android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/tasks_widget_left" android:layout_weight="1" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/tasks_widget_right" android:layout_weight="1" android:visibility="gone" android:layout_marginStart="20dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:id="@+id/tasks_widget_message" android:layout_weight="1" android:gravity="center_vertical" android:visibility="visible">
                <ImageView android:id="@+id/tasks_widget_message_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/omnesis_logo" android:tint="@color/tasks_widget_accent" android:padding="0dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/tasks_widget_ink" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:id="@+id/tasks_widget_message_title" android:text="Open Omnesis" android:layout_marginTop="5dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:id="@+id/tasks_widget_message_detail" android:text="Your tasks, close by." android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="1dp">
        <ImageView android:id="@+id/tasks_widget_previous" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_tasks_previous" android:tint="@color/tasks_widget_secondary" android:padding="7dp" android:scaleType="fitCenter" android:contentDescription="Previous period" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="10sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_reset" android:text="Today" android:layout_weight="1" android:gravity="center" />
        <ImageView android:id="@+id/tasks_widget_next" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_tasks_next" android:tint="@color/tasks_widget_secondary" android:padding="7dp" android:scaleType="fitCenter" android:contentDescription="Next period" />
        <TextView android:layout_width="wrap_content" android:layout_height="24dp" android:textSize="10sp" android:textColor="@color/tasks_widget_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:id="@+id/tasks_widget_page" android:minWidth="30dp" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp" android:background="@drawable/widget_tasks_selected" android:visibility="gone" />
        <ImageView android:id="@+id/tasks_widget_refresh" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_tasks_refresh" android:tint="@color/tasks_widget_secondary" android:padding="7dp" android:scaleType="fitCenter" android:contentDescription="Refresh tasks" />
    </LinearLayout>
</LinearLayout>
