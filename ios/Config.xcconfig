// Top-level build config. Tracked in git.
//
// Per-developer overrides live in Local.xcconfig (gitignored) — create it
// from Local.xcconfig.example and set your team and base bundle ID there. The
// optional include (#include?) is a no-op when the file is missing, so CI
// and other developers don't fail on a missing Local.xcconfig.
OMNESIS_BUNDLE_ID = dev.omnesis.ios
// Cloud account sign-in. These are the official app's public identifiers: the
// relay, the iOS Google OAuth client (no secret) and its callback scheme, the
// reversed client ID. A build under another identity overrides them in
// Local.xcconfig. The `$()` keeps xcconfig from reading `//` as a comment.
OMNESIS_CLOUD_RELAY_URL = https:/$()/relay.omnesis.app
OMNESIS_GOOGLE_CLIENT_ID = 69746762909-071jh21ngi85ne01k4oe5krfng2frmhr.apps.googleusercontent.com
OMNESIS_GOOGLE_CALLBACK_SCHEME = com.googleusercontent.apps.69746762909-071jh21ngi85ne01k4oe5krfng2frmhr
// Passkeys: the domain in the app's webcredentials entitlement. It must serve an
// apple-app-site-association file that lists this app.
OMNESIS_CLOUD_RELAY_RP_ID = relay.omnesis.app
// Debug builds only: let a test gateway with a private certificate join without the first-contact check.
OMNESIS_CLOUD_RELAY_SKIP_PUBLIC_CERTIFICATE_CHECK = 0
#include? "Local.xcconfig"
