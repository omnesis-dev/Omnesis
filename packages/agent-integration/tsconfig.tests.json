{
  // Typecheck the SUITES, which the package's own tsconfig excludes.
  //
  // The same lane every other package on it runs, for the same bug class: a
  // test file that is never typechecked cannot notice a dependency it does not
  // construct — a service gains a required member, the suite's hand-built deps
  // object omits it, and nothing says so until the code path that reads it
  // runs.
  //
  // `include` is every suite and `exclude` is the ones that do not pass yet, so
  // a NEW suite is checked from the day it is written. The exclusion list is a
  // ratchet: entries come off it as files are cleaned and nothing may be added
  // without saying why. It is not a permission to leave a suite unchecked — it
  // is a record of the ones that still are.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.test.ts", "src/**/*.d.ts"],
  // The ratchet. Each of these fails today; the list only ever shrinks.
  "exclude": ["src/answer-wait.test.ts", "src/http.test.ts", "src/openclaw.test.ts"]
}
