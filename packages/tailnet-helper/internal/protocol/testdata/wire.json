{
  "comment": "Messages both sides of the helper protocol must agree on. The Go tests check the helper parses every command and emits every event exactly as written; the gateway's tests check it reads every event and writes every command exactly as written.",
  "commands": [
    {
      "type": "gateway-certificate",
      "certificate": {
        "cert": "invented-certificate",
        "key": "invented-key"
      }
    },
    {
      "type": "configure",
      "public": {
        "enabled": true,
        "paths": ["/mcp", "/oauth/token", "/portal/css/"]
      }
    },
    {
      "type": "configure",
      "public": {
        "enabled": false,
        "paths": []
      }
    },
    {
      "type": "login"
    },
    {
      "type": "logout"
    },
    {
      "type": "rename",
      "hostname": "home-box"
    }
  ],
  "events": [
    {
      "type": "status",
      "protocol": 3,
      "backend": "running",
      "node": {
        "dnsName": "omnesis-1.example-net.ts.net",
        "hostName": "omnesis-1",
        "askedName": "omnesis",
        "tailnet": "example-net.ts.net",
        "ips": ["100.64.0.1", "fd7a:115c:a1e0::1"]
      },
      "owner": {
        "id": "7",
        "login": "maya@example.com",
        "displayName": "Maya Reeves"
      },
      "certificate": {
        "source": "tailscale"
      },
      "public": {
        "state": "on",
        "url": "https://omnesis-1.example-net.ts.net"
      }
    },
    {
      "type": "status",
      "protocol": 3,
      "backend": "running",
      "node": {
        "dnsName": "omnesis.example-net.ts.net",
        "hostName": "omnesis",
        "ips": ["100.64.0.1"]
      },
      "certificate": {
