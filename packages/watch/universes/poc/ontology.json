    {
      "tableName": "people",
      "displayName": "People",
      "description": "System-owned dimension projection of the people graph: canonical id, display name, self flag, and recency/interaction signals.",
      "columns": [
        {
          "name": "id",
          "type": "VARCHAR",
          "description": "Canonical person id.",
          "references": "person"
        },
        {
          "name": "canonical_name",
          "type": "VARCHAR",
          "description": "Display name."
        },
        {
          "name": "is_self",
          "type": "BOOLEAN",
          "description": "Whether this row is the operator."
        },
        {
          "name": "last_seen",
          "type": "TIMESTAMPTZ",
          "description": "Semantic time of the most recent document referencing this person \u2014 including calendar invites, so it is a coarse recency signal."
        },
        {
          "name": "interaction_score",
          "type": "DOUBLE",
          "description": "Weighted two-way interaction score; a sharper recency signal than last_seen."
        }
