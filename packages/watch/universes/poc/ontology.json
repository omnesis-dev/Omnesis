    {
      "tableName": "health_vitals",
      "displayName": "Health Vitals",
      "description": "Tall table of vital-sign readings; one row per metric per interval.",
      "sourceId": "apple-health",
      "columns": [
        {
          "name": "metric_slug",
          "type": "VARCHAR",
          "description": "Which vital this row measures.",
          "canonicalValues": ["resting_hr", "hrv", "respiratory_rate", "vo2_max", "body_mass"]
        },
        {
          "name": "value",
          "type": "DOUBLE",
          "description": "The reading."
        },
        {
          "name": "unit",
          "type": "VARCHAR",
          "description": "Unit the reading is expressed in."
        },
        {
          "name": "start_time",
          "type": "TIMESTAMPTZ",
          "description": "Start of the interval the reading covers."
        },
        {
          "name": "end_time",
          "type": "TIMESTAMPTZ",
          "description": "End of the interval the reading covers."
        }
      ],
      "primaryKey": ["metric_slug", "start_time"],
      "semanticTimeColumn": "start_time"
    },
    {
      "tableName": "health_sleep",
      "displayName": "Sleep Stages",
      "description": "One row per sleep stage interval. There is no duration or quality column \u2014 both are derived.",
      "sourceId": "apple-health",
      "columns": [
        {
          "name": "stage",
          "type": "VARCHAR",
          "description": "Which stage the interval was scored as.",
          "allowedValues": [
            "inBed",
            "asleepCore",
            "asleepDeep",
            "asleepREM",
            "asleepUnspecified",
            "awake"
          ]
        },
        {
          "name": "start_time",
          "type": "TIMESTAMPTZ",
          "description": "Start of the stage interval."
        },
        {
          "name": "end_time",
          "type": "TIMESTAMPTZ",
          "description": "End of the stage interval."
        }
      ],
      "primaryKey": ["stage", "start_time"],
      "semanticTimeColumn": "start_time"
    },
    {
      "tableName": "plaid_transactions",
      "displayName": "Bank Transactions (Plaid)",
      "description": "Bank and card transactions. The only transactions table carrying a category.",
      "sourceId": "plaid",
      "columns": [
        {
          "name": "id",
          "type": "VARCHAR",
          "description": "Provider transaction id."
        },
        {
          "name": "account_id",
          "type": "VARCHAR",
          "description": "Account the transaction posted to."
        },
        {
          "name": "date",
          "type": "DATE",
          "description": "Date the transaction is dated."
        },
        {
          "name": "amount",
          "type": "DECIMAL(18,4)",
          "description": "Signed amount; positive is money leaving the account."
        },
        {
          "name": "currency",
          "type": "VARCHAR",
          "description": "ISO currency code."
        },
        {
          "name": "merchant_name",
          "type": "VARCHAR",
          "description": "Merchant as the provider names it."
        },
        {
          "name": "category",
          "type": "VARCHAR",
          "description": "Provider-assigned category path."
        },
        {
          "name": "pending",
          "type": "BOOLEAN",
          "description": "Whether the transaction is still pending. A pending row is revised in place when it posts."
        }
      ],
      "primaryKey": ["id"],
      "semanticTimeColumn": "date"
    },
