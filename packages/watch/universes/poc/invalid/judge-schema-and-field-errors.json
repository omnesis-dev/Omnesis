{
  "watch": {
    "name": "judge-schema-and-field-errors",
    "firing_policy": "stays_active",
    "ontology_fingerprint": "poc-ontology-1",
    "nodes": [
      {
        "id": "mail",
        "type": "source.document_event",
        "filter": {
          "source": "gmail",
          "event": ["created"],
          "documentType": "email"
        },
        "output_map": {
          "why": "$judge.reason"
        },
        "recall": {
          "semantic": {
            "query": "a warm personal note from a friend",
            "threshold": 0.35
          }
        },
        "judge": {
          "proposition": "This note is personal",
          "output_schema": {
            "tone": "text"
          }
        }
      },
      {
        "id": "gate",
        "type": "stateless.transform",
        "inputs": {
          "mail": {
            "role": "arm"
          }
        },
        "query": "SELECT true AS fires"
      }
    ],
    "sink": {
      "input": "gate"
    }
  }
}
