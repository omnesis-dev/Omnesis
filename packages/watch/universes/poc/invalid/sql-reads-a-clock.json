{
  "watch": {
    "name": "sql-reads-a-clock",
    "firing_policy": "stays_active",
    "ontology_fingerprint": "poc-ontology-1",
    "nodes": [
      {
        "id": "tick",
        "type": "source.time",
        "recurring": "0 9 * * *"
      },
      {
        "id": "check",
        "type": "sql",
        "inputs": {
          "tick": {
            "role": "arm"
          }
        },
        "fire_on": "every_true",
        "query": "SELECT count(*) > 0 AS fires, random() AS r FROM health_vitals WHERE start_time > now() - INTERVAL 1 DAY AND start_time::DATE = current_date"
      }
    ],
    "sink": {
      "input": "check"
    }
  }
}
