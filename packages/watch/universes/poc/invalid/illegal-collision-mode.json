{
  "watch": {
    "name": "illegal-collision-mode",
    "firing_policy": "stays_active",
    "ontology_fingerprint": "poc-ontology-1",
    "nodes": [
      {
        "id": "inbound",
        "type": "source.document_event",
        "filter": {
          "source": "gmail",
          "event": ["created"],
          "documentType": "email",
          "people": [
            {
              "role": "sender",
              "isSelf": false
            }
          ]
        },
        "output_map": {
          "thread_id": "$e.metadata.extra.threadId",
          "doc_id": "$e.docId"
        }
      },
      {
        "id": "reply",
        "type": "source.document_event",
        "filter": {
          "source": "gmail",
          "event": ["created"],
          "documentType": "email",
          "people": [
            {
              "role": "sender",
              "isSelf": false
            }
          ]
        },
        "output_map": {
          "thread_id": "$e.metadata.extra.threadId"
        }
      },
      {
        "id": "both",
        "type": "stateful.and",
        "inputs": {
          "inbound": {
            "role": "arm",
            "key": {
              "thread_id": ".thread_id"
            }
          },
          "reply": {
            "role": "arm",
            "key": {
              "thread_id": ".thread_id"
            }
          }
        },
        "on_collision": "spawn",
        "deadline": "7 days"
      }
    ],
    "sink": {
      "input": "both"
    }
  }
}
