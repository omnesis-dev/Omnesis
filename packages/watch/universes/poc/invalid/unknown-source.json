{
  "watch": {
    "name": "unknown-source",
    "firing_policy": "stays_active",
    "ontology_fingerprint": "poc-ontology-1",
    "nodes": [
      {
        "id": "mail",
        "type": "source.document_event",
        "filter": {
          "source": "riverside-notes",
          "event": ["created"]
        },
        "output_map": {
          "doc_id": "$e.docId"
        }
      },
      {
        "id": "gate",
        "type": "stateless.transform",
        "inputs": {
          "mail": {
            "role": "arm"
          }
        },
        "query": "SELECT true AS fires"
      }
    ],
    "sink": {
      "input": "gate"
    }
  }
}
