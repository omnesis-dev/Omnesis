{
  "watch": {
    "name": "initial-level-without-edge-detection",
    "firing_policy": "stays_active",
    "ontology_fingerprint": "poc-ontology-1",
    "nodes": [
      {
        "id": "tick",
        "type": "source.time",
        "recurring": "0 9 * * *"
      },
      {
        "id": "check",
        "type": "sql",
        "inputs": {
          "tick": {
            "role": "arm"
          }
        },
        "fire_on": "every_true",
        "initial_level": "first_observation",
        "query": "SELECT avg(value) > 70 AS fires, avg(value) AS avg_hr FROM health_vitals"
      }
    ],
    "sink": {
      "input": "check"
    }
  }
}
