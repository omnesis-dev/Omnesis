{
  "watch": {
    "name": "unknown-person",
    "firing_policy": "stays_active",
    "ontology_fingerprint": "poc-ontology-1",
    "nodes": [
      {
        "id": "mail",
        "type": "source.document_event",
        "filter": {
          "source": "gmail",
          "event": ["created"],
          "people": [
            {
              "role": "sender",
              "person": "00000000-0000-4000-8000-00000000dead"
            }
          ]
        },
        "output_map": {
          "doc_id": "$e.docId"
        }
      },
      {
        "id": "gate",
        "type": "stateless.transform",
        "inputs": {
          "mail": {
            "role": "arm"
          }
        },
        "query": "SELECT true AS fires"
      }
    ],
    "sink": {
      "input": "gate"
    }
  }
}
