  // Typecheck the SUITES, which the package's own tsconfig excludes.
  //
  // A test file that is never typechecked cannot notice a dependency it does
  // not construct: a route or service gains a required member, the suite's
  // hand-built deps object omits it, and nothing says so until the code path
  // that reads it runs — as a 500, or never, if no case drives it. That shape
  // has shipped repeatedly, and it is always a dependency object rather than a
  // fixture. See omnesis-dev/Omnesis#1885.
  //
  // `include` is every suite and `exclude` is the ones that do not pass yet, so
  // a NEW suite is checked from the day it is written. The exclusion list is a
  // ratchet: entries come off it as files are cleaned and nothing may be added
  // without saying why. It is not a permission to leave a suite unchecked — it
  // is a record of the ones that still are.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // The portal sits beside `src`, not under it. Nothing is emitted here, so
    // the root only decides which files may be in the program.
    "rootDir": "."
  },
  // The ambient declarations too: a suite pulls in the sources it exercises,
  // and those need the same module shims the package build gives them.
  "include": ["src/**/*.test.ts", "src/**/*.d.ts", "portal/**/*.test.ts"],
  "exclude": [
