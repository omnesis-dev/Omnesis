    {
      "number": 6,
      "title": "How should plugins declare their data requirements?",
      "body": "A plugin needs to say which datasets it reads before it is granted anything. Manifest field, or a call at activation time?",
      "createdAt": "2026-05-20T13:00:00Z",
      "updatedAt": "2026-05-21T08:15:00Z",
      "url": "https://github.com/northstar-labs/atlas/discussions/6",
      "author": { "__typename": "User", "login": "dave-ortiz", "name": "Dave Ortiz" },
      "category": { "name": "Ideas" },
      "answer": { "id": "DC_answer_6" },
      "comments": {
        "totalCount": 1,
        "nodes": [
          {
            "author": { "__typename": "User", "login": "emma-park", "name": "Emma Park" },
            "body": "Manifest. A declaration made at activation time cannot be reviewed before the plugin is installed, which is the only moment the decision matters.",
            "createdAt": "2026-05-21T08:15:00Z",
            "isAnswer": true,
            "replies": { "nodes": [] }
          }
        ]
      }
    }
