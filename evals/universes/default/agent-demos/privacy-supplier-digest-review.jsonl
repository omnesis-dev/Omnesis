# so what leaves is what was drafted and the release step reports `identical`.
#
# The submit_privacy_review call carries no recorded result: the replay backend
# invokes the reviewer's real submission tool, which is what makes this a review
# the gateway acts on rather than a transcript of one.
{"afterMs":30,"event":{"type":"agent.message.start","payload":{"sessionId":"$SESSION","messageId":"$MSG","role":"assistant"}}}
