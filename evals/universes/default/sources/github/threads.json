  "discussions": [
    {
      "number": 6,
      "title": "How should plugins declare their data requirements?",
      "body": "A plugin needs to say which datasets it reads before it is granted anything. Manifest field, or a call at activation time?",
      "createdAt": "2026-05-20T13:00:00Z",
      "updatedAt": "2026-05-21T08:15:00Z",
      "url": "https://github.com/northstar-labs/atlas/discussions/6",
      "author": { "__typename": "User", "login": "dave-ortiz", "name": "Dave Ortiz" },
      "category": { "name": "Ideas" },
      "answer": { "id": "DC_answer_6" },
      "comments": {
        "totalCount": 1,
        "nodes": [
          {
            "author": { "__typename": "User", "login": "emma-park", "name": "Emma Park" },
            "body": "Manifest. A declaration made at activation time cannot be reviewed before the plugin is installed, which is the only moment the decision matters.",
            "createdAt": "2026-05-21T08:15:00Z",
            "isAnswer": true,
            "replies": { "nodes": [] }
          }
        ]
      }
    },
    {
      "number": 11,
      "title": "Where should the query language go next?",
      "body": "Saved views cover the common questions, but anything with a join is still a support request. Two directions have come up: a small expression language over the existing filters, or a full text-to-query layer.\n\nThe timezone problem in #2 is worth settling first either way — a query language that inherits it will bake it in.",
      "createdAt": "2026-06-05T09:00:00Z",
      "updatedAt": "2026-06-07T11:45:00Z",
      "url": "https://github.com/northstar-labs/atlas/discussions/11",
      "author": { "__typename": "User", "login": "john-smith", "name": "John Smith" },
      "category": { "name": "Roadmap" },
      "answer": null,
      "comments": {
        "totalCount": 2,
        "nodes": [
          {
            "author": { "__typename": "User", "login": "alex-chen", "name": "Alex Chen" },
            "body": "Expression language first. It is a smaller surface, and it gives the text-to-query layer something to compile into later instead of generating SQL directly.",
            "createdAt": "2026-06-06T14:30:00Z",
            "isAnswer": false,
            "replies": {
              "nodes": [
                {
                  "author": { "__typename": "User", "login": "jane-doe", "name": "Jane Doe" },
                  "body": "That also keeps the permission check in one place. Anything generating SQL directly has to re-derive who may read what.",
                  "createdAt": "2026-06-06T15:10:00Z"
                }
              ]
            }
          },
          {
            "author": { "__typename": "User", "login": "emma-park", "name": "Emma Park" },
            "body": "Whichever lands first needs an error surface people can act on. The current parser failure is a stack trace in a toast.",
            "createdAt": "2026-06-07T11:45:00Z",
            "isAnswer": false,
            "replies": { "nodes": [] }
          }
        ]
      }
    }
  ]
