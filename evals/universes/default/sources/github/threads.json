      },
      "milestone": { "title": "v2.1" },
      "comments": {
        "totalCount": 1,
        "nodes": [
          {
            "author": { "__typename": "User", "login": "john-smith", "name": "John Smith" },
            "body": "Reproduced. The filter is applied after the page slice, so the boundary row is consumed and discarded. Taking this one.",
            "createdAt": "2026-05-13T16:40:00Z"
          }
        ]
      }
    },
