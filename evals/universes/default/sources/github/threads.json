    {
      "__typename": "Issue",
      "number": 12,
      "title": "Rate limit the webhook retry loop",
      "body": "A subscriber returning 500 gets retried immediately and forever. @jane-doe hit this with a staging endpoint that was down for an afternoon; the queue never drained.\n\nA capped exponential backoff with a dead-letter after the last attempt would be enough.",
      "state": "OPEN",
      "createdAt": "2026-06-08T16:45:00Z",
      "updatedAt": "2026-06-09T10:20:00Z",
      "closedAt": null,
