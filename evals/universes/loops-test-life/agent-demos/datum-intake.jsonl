# Golden cassette: one datum-intake run, replayed verbatim.
# Every tool.start below omits its result, so the REAL tool layer executes and
# the writes land for real. `capture` lifts the ids the gateway actually minted
# so the later calls address the loop and observation that now exist, not the
# recorded ones. The observation's quote appears verbatim in the document.
{"afterMs": 0, "event": {"type": "agent.message.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "role": "assistant"}}}
{"afterMs": 0, "event": {"type": "agent.text.delta", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "delta": "A deposit is outstanding; tracking it and noting it for the morning brief.\n"}}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-fetch", "tool": "fetch_many", "args": {"documents": [{"documentId": "$DOC_bench-cassette-deposit"}]}}}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-search", "tool": "open_loop_search", "args": {"query": "harvest fair stand deposit"}}}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-loop", "tool": "open_loop_create", "args": {"title": "Send the deposit for the harvest fair stand", "description": "The stand is held until the deposit is sent.", "confidence": 0.9, "importance": 0.75, "docs": ["$DOC_bench-cassette-deposit"], "annotationDependencies": []}}}, "capture": {"loop1": "data.loop.id"}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-loop-read", "tool": "open_loop_fetch", "args": {"id": "$CAP_loop1"}}}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-ledger", "tool": "open_loop_ledger_append", "args": {"id": "$CAP_loop1", "note": "Stand held pending the deposit; no date given yet."}}}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-obs-list", "tool": "observation_list", "args": {}}}}
{"afterMs": 0, "event": {"type": "agent.tool.start", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "toolCallId": "tc-obs", "tool": "observation_note", "args": {"summary": "The harvest fair stand is held only until the deposit is sent.", "why": "Without the deposit the stand can be given away.", "citations": ["$DOC_bench-cassette-deposit"], "claims": [{"docId": "$DOC_bench-cassette-deposit", "quote": "The stand is held until the deposit is sent."}], "relatedLoopIds": ["$CAP_loop1"], "relevantUntil": "2031-03-20T17:00:00.000Z", "annotationDependencies": []}}}, "capture": {"obs1": "data.id"}}
{"afterMs": 0, "event": {"type": "agent.text.delta", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "delta": "Tracked the obligation and noted one observation."}}}
{"afterMs": 0, "event": {"type": "agent.message.end", "payload": {"sessionId": "$SESSION", "messageId": "$MSG", "stopReason": "end_turn"}}}
